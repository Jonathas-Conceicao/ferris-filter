# test_ff.filter - FerrisFilter manual UI test filter (not loaded by any automated test).
# Copy it into a TEMP game folder (see tests/ui/README.md) and open it in ff.
# Each rule is one UI case; tests/ui/README.md says what to look for.

# ff:name Bare Show
Show

# ff:name Preset S
# ff:style builtin:S S
Show
	BaseType == "Divine Orb" "Mirror of Kalandra"
	SetTextColor 255 121 198 255
	SetBorderColor 255 121 198 255
	SetBackgroundColor 40 42 54 255
	SetFontSize 37
	MinimapIcon 0 Pink Circle
	PlayEffect Pink
	CustomAlertSound "uwu.mp3" 300

# ff:name Preset kite
# ff:style kite
Show
	UnidentifiedItemTier >= 4
	MinimapIcon 1 Orange Kite
	PlayEffect Orange
	PlayAlertSound 2 300

# ff:name Unknown style
# ff:style zz9999 Mystery
Show
	Class == "Gloves"

# ff:name Grammar error
Show
	Class == "Body Armours"
	Sockets >= abc

# ff:name Grammar warning
Show
	Class == "Boots"
	LinkedSockets >= 5

# ff:name Disabled valid
# Show
# 	Class == "Belts"

# ff:name Disabled invalid
# Show
# 	Rarity >= Bogus

# ff:name Broken group
# ff:group brk001 1/2
Show
	Class == "Helmets"
	BaseArmour > 0

################################################################################
# ff:section Leveling
################################################################################

# ff:name Continue
Show
	AreaLevel <= 20
	SetFontSize 32
	Continue

# ff:name Move across Continue
Show
	Class == "Rings" "Amulets"
	Rarity >= Magic

# ff:name Custom style
Show
	Class == "Waystones"
	WaystoneTier >= 10
	SetTextColor 255 184 108
	SetBorderColor 255 184 108 200
	SetBackgroundColor 40 42 54 240
	SetFontSize 40
	MinimapIcon 1 Blue Star
	PlayEffect Blue Temp
	PlayAlertSound 6 200
	DisableDropSound

# ff:name Simple Defences group
# ff:group sdg001 1/2
Show
	Rarity Rare
	Class == "Body Armours"
	BaseArmour > 0
	BaseEvasion 0
	BaseEnergyShield 0

# ff:name Simple Defences group
# ff:group sdg001 2/2
Show
	Rarity Rare
	Class == "Body Armours"
	BaseArmour 0
	BaseEvasion > 0
	BaseEnergyShield 0

################################################################################
# ff:section Endgame
################################################################################

# ff:name Between, booleans, sockets
Show
	ItemLevel >= 75
	ItemLevel <= 82
	Corrupted False
	Identified True
	Sockets >= 5GGG

# ff:name Defences card
Show
	Class == "Shields"
	BaseArmour >= 150
	BaseEnergyShield >= 40

# ff:name Quoted list
Show
	BaseType == "Sapphire Ring" "Ruby Ring" "Topaz Ring" "Amethyst Ring" "Emerald Ring" "Gold Ring" "Iron Ring" "Prismatic Ring" "Lazuli Ring"
	Rarity Normal

# ff:name Class outside groups
Show
	Class "Body Armours" "Fishing Rods"
	Quality >= 10

# ff:name Extra action rows
Show
	Class == "Jewels"
	PlayAlertSoundPositional 3 150
	CustomAlertSoundOptional "missing.mp3" 100
	EnableDropSound
	MinimapIcon -1
	PlayEffect None

# ff:name Hidden preset
# ff:style builtin:hidden hidden
Hide
	Class == "Flasks"
	SetFontSize 21
	DisableDropSound

Show
	Rarity == Normal
	AreaLevel <= 10

################################################################################
# ff:economy-begin Economy (generated by FerrisFilter, do not edit)
################################################################################

Show
	BaseType == "Chaos Orb"
	SetTextColor 189 147 249 255
	SetBorderColor 189 147 249 255
	SetBackgroundColor 40 42 54 255

Show
	BaseType == "Exalted Orb"
	SetTextColor 255 85 85 255
	SetBorderColor 255 85 85 255
	SetBackgroundColor 40 42 54 255
