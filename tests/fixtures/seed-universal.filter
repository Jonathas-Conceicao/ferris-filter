# universal.filter
# GENERATED FROM config.json — edit the model, not this file (then regenerate).
#
# Block tags link each rule back to the model:
#   [alwaysShow.K]          -> a level-independent highlight
#   [areaLevelBands "R".K]  -> band R, show-key K
#   [styles.X]              -> the style entry applied
#
# Philosophy: HIDE what we don't want, STYLE the few highlights, let everything
# else fall through to the game default (uniques, jewels, gems, jewellery, quest
# items, waystones, trials, unidentified — no rules touch them).
# Currency base lists are curated data kept outside the model (carried over here).

Show # recycle: sockets + quality salvage
  Quality >= 1
  Sockets >= 1
  PlayEffect Green
  MinimapIcon 2 Green Cross
  SetTextColor 80 250 123 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 80 250 123 255

Show # band <=5: all armour any rarity
  AreaLevel <= 5
  Class "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"

Show # band 6-25: build weapons any rarity
  AreaLevel <= 25
  Class "Staves" "Wands" "Foci"

Show # bands 26+: build weapons Magic+Rare (capped)
  AreaLevel <= 75
  Class "Staves" "Wands" "Foci"
  Rarity >= Magic

Show # band 6-25: build armour (non-evasion)
  AreaLevel <= 25
  Class "Body Armours" "Helmets" "Gloves" "Boots"
  BaseEvasion 0
  Rarity >= Magic

Show # band 26-45: build armour (ES / hybrid)
  AreaLevel >= 26
  AreaLevel <= 45
  Class "Body Armours" "Helmets" "Gloves" "Boots"
  BaseEvasion 0
  BaseEnergyShield > 0
  Rarity >= Magic

Show # bands 46+: build armour (pure ES)
  AreaLevel >= 46
  AreaLevel <= 75
  Class "Body Armours" "Helmets" "Gloves" "Boots"
  BaseArmour 0
  BaseEvasion 0
  BaseEnergyShield > 0
  Rarity >= Magic

Show # unidentified high-tier: weapons + armour
  Class "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"
  UnidentifiedItemTier >= 4
  PlayEffect Orange
  MinimapIcon 2 Orange Kite
  PlayAlertSound 2 200

Show # unidentified high-tier: jewellery
  Class "Rings" "Amulets" "Belts"
  UnidentifiedItemTier >= 4
  PlayEffect Orange
  MinimapIcon 2 Orange Kite
  PlayAlertSound 2 200

Show # bands <=45: any other Rare gear
  AreaLevel <= 45
  Class "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Quarterstaves" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"
  Rarity == Rare

Hide # gear fallback: hide unmatched equipment
  Class "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Quarterstaves" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"
  Rarity <= Rare
  SetFontSize 21
  DisableDropSound

Hide # jewellery fallback: hide low-rarity Rings/Amulets/Belts
  Class "Rings" "Amulets" "Belts"
  Rarity <= Rare
  SetFontSize 21
  DisableDropSound

Show # flasks/charms: quality always
  Class "Life Flasks" "Mana Flasks" "Charms"
  Quality >= 1

Show # bands <=25: all flasks/charms
  AreaLevel <= 25
  Class "Life Flasks" "Mana Flasks" "Charms"

Show # bands 26-65: magic flasks/charms
  AreaLevel <= 65
  Class "Life Flasks" "Mana Flasks" "Charms"
  Rarity >= Magic

Show # bands 78+: normal charms
  AreaLevel >= 78
  Class "Charms"
  Rarity == Normal

Hide # flasks/charms fallback
  Class "Life Flasks" "Mana Flasks" "Charms"
  Rarity <= Magic
  SetFontSize 21
  DisableDropSound

#============================================================
# alwaysShow.currency — tiered S-F  [styles.S .. styles.F]
# Each block's tier letter = the styles.<tier> applied. Base lists are
# curated data carried over from the prior filter (not stored in the model).
# Gems are intentionally omitted (fall through to game default).
#============================================================

# --- Currency ---
Show # Currency S
  Class == "Stackable Currency"
  BaseType == "Divine Orb" "Perfect Chaos Orb" "Mirror of Kalandra" "Hinekora's Lock" "Perfect Exalted Orb" "Fracturing Orb" "Albino Rhoa Feather" "Vaal Cultivation Orb" "Perfect Jeweller's Orb" "Core Destabiliser" "Architect's Orb" "Ancient Infuser" "Crystallised Corruption" "Greater Chaos Orb" "Perfect Regal Orb" "Orb of Annulment" "Orb of Extraction"
  PlayEffect Pink
  MinimapIcon 1 Pink Circle
  SetTextColor 255 121 198 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 255 121 198 255
  SetFontSize 37
  CustomAlertSound "uwu.mp3" 300

