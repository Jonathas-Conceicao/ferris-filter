# dynamic.filter
# GENERATED FROM dynamic.json — edit the model, not this file (then regenerate).
#
# Block tags link each rule back to the model:
#   [alwaysShow.K]          -> a level-independent highlight
#   [areaLevelBands "R".K]  -> band R, show-key K
#   [styles.X]              -> the style entry applied
#
# Philosophy: HIDE what we don't want, STYLE the few highlights, let everything
# else fall through to the game default (uniques, jewels, gems, jewellery, quest
# items, waystones, trials, unidentified — no rules touch them).
# Currency base lists are curated data kept outside the model (carried over here).

Show # Chance bases
  Rarity == Normal
  Corrupted False
  BaseType == "Heavy Belt" "Utility Belt" "Armoured Cap" "Sacred Focus"

Show # Exceptional 3 socks
  Class "Body Armours" "Two Hand Maces" "Bows" "Crossbows" "Quarterstaves" "Staves"
  Sockets >= 3
  Corrupted False
  PlayEffect Pink
  MinimapIcon 2 Pink Cross
  SetTextColor 255 121 198 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 255 121 198 255

Show # Exceptional 2 socks
  Class "Helmets" "Gloves" "Boots" "Shields" "Bucklers" "Foci" "One Hand Maces" "Sceptres" "Wands" "Spears"
  Sockets >= 2
  Corrupted False
  PlayEffect Pink
  MinimapIcon 2 Pink Cross
  SetTextColor 255 121 198 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 255 121 198 255

Show # Exceptional Quality
  Class "Body Armours" "Two Hand Maces" "Bows" "Crossbows" "Quarterstaves" "Staves" "Helmets" "Gloves" "Boots" "Shields" "Bucklers" "Foci" "One Hand Maces" "Sceptres" "Wands" "Spears" "Talismans"
  Quality >= 21
  Corrupted False
  PlayEffect Pink
  MinimapIcon 2 Pink Cross
  SetTextColor 255 121 198 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 255 121 198 255

Show # rule 4
  Quality >= 1
  Sockets >= 1
  PlayEffect Green
  MinimapIcon 2 Green Cross
  SetTextColor 80 250 123 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 80 250 123 255

Show # Maybe sell this
  Class "Rings" "Amulets" "Belts" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers" "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Quarterstaves" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands"
  UnidentifiedItemTier >= 5
  PlayEffect Orange
  MinimapIcon 2 Orange Kite
  PlayAlertSound 2 200

Hide # Hide other itens
  Class "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Quarterstaves" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers" "Rings" "Amulets" "Belts" "Life Flasks" "Mana Flasks" "Charms" "Jewels"
  Rarity <= Rare
  SetFontSize 21
  DisableDropSound

Hide # Unwanted Currecny
  BaseType == "Scroll of Wisdom" "Regal Shard"
  SetFontSize 21
  DisableDropSound

Show # Show time-lost jewels
  BaseType == "Time-Lost Diamond" "Time-Lost Sapphire" "Time-Lost Ruby" "Time-Lost Emerald"

#============================================================
# alwaysShow.currency — tiered S-F  [styles.S .. styles.F]
# Each block's tier letter = the styles.<tier> applied. Base lists are
# curated data carried over from the prior filter (not stored in the model).
# Gems are intentionally omitted (fall through to game default).
#============================================================

