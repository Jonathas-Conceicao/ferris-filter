# universal.filter
# GENERATED FROM config.json — edit the model, not this file (then regenerate).
#
# Block tags link each rule back to the model:
#   [alwaysShow.K]          -> a level-independent highlight
#   [areaLevelBands "R".K]  -> band R, show-key K
#   [styles.X]              -> the style entry applied
#
# Philosophy: HIDE what we don't want, STYLE the few highlights, let everything
# else fall through to the game default (uniques, jewels, gems, jewellery, quest
# items, waystones, trials, unidentified — no rules touch them).
# Currency base lists are curated data kept outside the model (carried over here).

#============================================================
# alwaysShow.recycle  ->  styles.Recycle
#============================================================

Show # recycle: sockets + quality salvage  [alwaysShow.recycle -> styles.Recycle]
  Sockets >= 1
  Quality >= 1
  PlayEffect Green
  MinimapIcon 2 Green Cross
  SetTextColor 80 250 123 255
  SetBackgroundColor 40 42 54 255
  SetBorderColor 80 250 123 255

#============================================================
# areaLevelBands — gear
# Shown gear = styles.unchanged (Show, no restyle, protects it from the
# trailing Hide). The Hide fallback = styles.hidden. Uniques excluded from
# the fallback so they fall through.
#============================================================

# [areaLevelBands "1-5".allArmour] all armour, any rarity
# (build weapons come from the weapon rules below; rares of any class from the <=45 otherGear rule)
Show # band <=5: all armour any rarity  [areaLevelBands "1-5".allArmour -> styles.unchanged]
  AreaLevel <= 5
  Class "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"

# [areaLevelBands "6-25".weapons] build weapons, any rarity
Show # band 6-25: build weapons any rarity  [build.weapons -> styles.unchanged]
  AreaLevel <= 25
  Class "Staves" "Wands" "Foci"

# [areaLevelBands 26+ .weapons "Rare only"] build weapons, Rare, any level
Show # bands 26+: build weapons Rare only  [build.weapons -> styles.unchanged]
  Class "Staves" "Wands" "Foci"
  Rarity == Rare

# [areaLevelBands "6-25".armour anyNonEvasion, Magic+Rare]
Show # band 6-25: build armour (non-evasion)  [build.armour/anyNonEvasion -> styles.unchanged]
  AreaLevel <= 25
  Class "Body Armours" "Helmets" "Gloves" "Boots"
  BaseEvasion 0
  Rarity >= Magic

# [areaLevelBands "26-45".armour esHybrid, Magic+Rare]
Show # band 26-45: build armour (ES / hybrid)  [build.armour/esHybrid -> styles.unchanged]
  AreaLevel >= 26
  AreaLevel <= 45
  Class "Body Armours" "Helmets" "Gloves" "Boots"
  BaseEnergyShield > 0
  BaseEvasion 0
  Rarity >= Magic

# [areaLevelBands "46-65"+"66+".armour pureES, Magic+Rare]
Show # bands 46+: build armour (pure ES)  [build.armour/pureES -> styles.unchanged]
  AreaLevel >= 46
  Class "Body Armours" "Helmets" "Gloves" "Boots"
  BaseEnergyShield > 0
  BaseArmour 0
  BaseEvasion 0
  Rarity >= Magic

# [areaLevelBands "6-25"+"26-45".otherGear "Rare"] any other equipment, Rare, <=45
Show # bands <=45: any other Rare gear  [areaLevelBands.otherGear -> styles.unchanged]
  AreaLevel <= 45
  Class "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Quarterstaves" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"
  Rarity == Rare

# [fallthrough guard] hide remaining equipment (uniques excluded -> fall through)
Hide # gear fallback: hide unmatched equipment  [styles.hidden]
  Class "Bows" "Crossbows" "Foci" "One Hand Maces" "Quivers" "Quarterstaves" "Sceptres" "Spears" "Talismans" "Staves" "Two Hand Maces" "Wands" "Body Armours" "Helmets" "Gloves" "Boots" "Shields" "Bucklers"
  Rarity <= Rare
  SetFontSize 21
  DisableDropSound

#============================================================
# areaLevelBands — flasks & charms  [flaskCharmClasses]
#============================================================

# quality always shown (this is the ">65 Quality only" tier)
Show # flasks/charms: quality always  [areaLevelBands.flasksCharms -> styles.unchanged]
  Quality >= 1
  Class "Life Flasks" "Mana Flasks" "Charms"

# [areaLevelBands "1-5"+"6-25".flasksCharms "any rarity"]
Show # bands <=25: all flasks/charms  [styles.unchanged]
  AreaLevel <= 25
  Class "Life Flasks" "Mana Flasks" "Charms"

# [areaLevelBands "26-45"+"46-65".flasksCharms "Magic"]
Show # bands 26-65: magic flasks/charms  [styles.unchanged]
  AreaLevel <= 65
  Class "Life Flasks" "Mana Flasks" "Charms"
  Rarity == Magic

# remaining flasks/charms hidden
Hide # flasks/charms fallback  [styles.hidden]
  Class "Life Flasks" "Mana Flasks" "Charms"
  SetFontSize 21
  DisableDropSound

#============================================================
# alwaysShow.currency — tiered S-F  [styles.S .. styles.F]
# Each block's tier letter = the styles.<tier> applied. Base lists are
# curated data carried over from the prior filter (not stored in the model).
# Gems are intentionally omitted (fall through to game default).
#============================================================

# --- Currency ---
