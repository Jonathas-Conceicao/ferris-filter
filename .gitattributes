# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Filter and doc files are text.
*.filter text
*.md     text

# Parser fixtures must keep their exact bytes (CRLF/LF/no-final-newline); never renormalize.
tests/fixtures/parser/*.filter -text
tests/fixtures/v04-dynamic.filter -text

# Treat audio as binary (no EOL conversion, no diff).
*.mp3 binary

# Aseprite sources (custom art) are binary.
*.ase binary

# Shell scripts must stay LF: bash on the Windows runner cannot run CRLF scripts.
*.sh text eol=lf

# Icons are binary.
*.ico binary
