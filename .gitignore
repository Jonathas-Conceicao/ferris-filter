# Old/stale filters kept locally for reference only — not version-controlled.
reference-old-filters/

# Rust build artifacts
/target/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# Generated outputs — `sync` writes prices.json, `generate` writes universal.filter.
# These are regenerated on demand and intentionally NOT committed. The committed seed
# used by tests lives in tests/fixtures/seed-prices.json / seed-universal.filter.
/prices.json
/universal.filter

# Dynamic filter: `apply` edits dynamic.filter in the game folder in place (the filter
# is the store); a repo-root copy is per-user and never committed.
/dynamic.filter

# Obsolete v0.4 per-user store. Nothing reads dynamic.json since Phase 18 (the filter is the
# store), but a leftover copy is personal state; ignored only so it is never committed.
/dynamic.json

# One-time backups `apply` keeps beside a filter it rewrites (`<name>.filter.ffbak`).
*.ffbak

# Per-user overlay settings (selected game-folder filter). Never committed.
/ff-settings.json
/ff-state.json

# Per-user live config. The overlay's Apply writes these; when absent, styles-default.json /
# tiers-default.json (committed) are read instead. Delete one to reset it to the defaults.
/styles.json
/tiers.json

# My personal notes
human_notes.org

# installer/package.sh output (setup exe, zip, checksums); never committed
/dist/
